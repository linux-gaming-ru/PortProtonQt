<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-portproton-prefix-backup">
    <comment>PortProton prefix backup</comment>
    <comment xml:lang="ru">Резервная копия префикса PortProton</comment>
    <glob pattern="*.ppack"/>
  </mime-type>
  <mime-type type="application/x-portproton-autoinstall">
    <comment>PortProton auto install script</comment>
    <comment xml:lang="ru">Скрипт автоустановки PortProton</comment>
    <glob pattern="*.ppai"/>
  </mime-type>
  <mime-type type="application/x-portproton-ppdb">
    <comment>PortProton configuration</comment>
    <comment xml:lang="ru">Конфигурация PortProton</comment>
    <sub-class-of type="text/plain"/>
    <glob pattern="*.ppdb" weight="100"/>
  </mime-type>
  <mime-type type="application/x-portproton-user-conf">
    <comment>PortProton user configuration</comment>
    <comment xml:lang="ru">Пользовательская конфигурация PortProton</comment>
    <sub-class-of type="text/plain"/>
    <glob pattern="user.conf" weight="100"/>
  </mime-type>
</mime-info>
